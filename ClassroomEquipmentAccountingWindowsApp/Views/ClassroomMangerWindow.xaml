<Window x:Class="ClassroomEquipmentAccountingWindowsApp.Views.ClassroomMangerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабинет" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" Padding="14">
    <Grid Width="320" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Номер кабинета" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" Margin="0,6,0,12" Height="34" Padding="8" 
                 Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="Специальность кабинета" FontWeight="SemiBold"/>
            <TextBox Margin="0,6,0,12" Height="34" Padding="8"
                     Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Заведующий" FontWeight="SemiBold"/>
            <ComboBox Margin="0,6,0,0" Height="34" ItemsSource="{Binding Managers}" 
                      SelectedItem="{Binding SelectedManager}" DisplayMemberPath="ShortName"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Сохранить" Command="{Binding SaveCommand}" Width="160" Height="36" 
                HorizontalAlignment="Center" Background="#222" Foreground="White"/>
    </Grid>
</Window>
