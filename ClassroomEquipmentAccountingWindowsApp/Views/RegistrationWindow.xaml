<Window x:Class="ClassroomEquipmentAccountingWindowsApp.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassroomEquipmentAccountingWindowsApp.Views"
        xmlns:vm="clr-namespace:ClassroomEquipmentAccountingWindowsApp.ViewModels"
        mc:Ignorable="d"
        Title="Регистрация" Height="450" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:RegistrationWindowViewModel/>
    </Window.DataContext>
    
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBox Width="250" Height="30" Margin="0,0,0,5" Text="{Binding Login}"/>

        <TextBox Width="250" Height="30" Margin="0,5,0,5" Text="{Binding Password}"/>

        <TextBox Width="250" Height="30" Margin="0,5,0,5" Text="{Binding Firstname}"/>

        <TextBox Width="250" Height="30" Margin="0,5,0,5" Text="{Binding Lastname}"/>

        <TextBox Width="250" Height="30" Margin="0,5,0,5" Text="{Binding Middlename}"/>

        <Button Width="150" Height="30" Margin="0,5,0,0" Command="{Binding RegisterCommand}" Content="Зарегестрировать"/>

    </StackPanel>
    
</Window>
